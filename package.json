{
  "name": "fcloud-edge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Family Cloud 边缘版 —— Cloudflare Workers + D1 + R2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute fcloud --file=./migrations/0001_init.sql --remote",
    "d1:init:local": "wrangler d1 execute fcloud --file=./migrations/0001_init.sql --local",
    "d1:schema:local": "wrangler d1 execute fcloud --file=./migrations/0001_init.sql --local --persist-to=.wrangler/state",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
